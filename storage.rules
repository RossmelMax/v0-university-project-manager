rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{allPaths=**} {
      // Público para lectura (el visor de Google Docs lo necesita)
      allow read: if true;
      // Solo admins autenticados pueden subir/borrar
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
